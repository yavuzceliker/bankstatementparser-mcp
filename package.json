  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bankstatementparser-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bank-statement",
    "pdf-parser",
    "qbo",
    "ofx",
    "xero",
    "fintech"
